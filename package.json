{
  "name": "otools-localsend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite --port 6497 --strictPort",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "build:web": "node scripts/build-web.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "smoke": "python -I scripts/smoke-native.py",
    "test": "node --test scripts/*.test.mjs && node --experimental-strip-types --test src/hooks/*.test.ts",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0",
    "typescript": "^5.5.4",
    "unocss": "^66.7.5",
    "vite": "^5.4.2"
  }
}
